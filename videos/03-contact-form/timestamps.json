 "segments": [
  {
   "index": 0,
   "text": "Your contact form is where leads die.",
   "start": 0.08,
   "end": 2.465
  },
  {
   "index": 1,
   "text": "A lead fills it out.",
   "start": 2.685,
   "end": 4.07
  },
  {
   "index": 2,
   "text": "It lands in your inbox, under a pile of newsletters.",
   "start": 4.11,
   "end": 7.12
  },
  {
   "index": 3,
   "text": "Nobody sees it.",
   "start": 7.24,
   "end": 8.475
  },
  {
   "index": 4,
   "text": "No reply.",
   "start": 8.535,
   "end": 9.62
  },
  {
   "index": 5,
   "text": "So they book someone else.",
   "start": 9.78,
   "end": 11.14
  },
  {
   "index": 6,
   "text": "Fix it in three steps.",
   "start": 11.44,
   "end": 12.975
  },
  {
   "index": 7,
   "text": "One. Instant alert to your phone.",
   "start": 13.115,
   "end": 15.025
  },
  {
   "index": 8,
   "text": "Two. Auto-reply in seconds.",
   "start": 15.105,
   "end": 16.94
  },
  {
   "index": 9,
   "text": "Three. Every lead goes into a CRM.",
   "start": 17.02,
   "end": 19.505
  },
  {
   "index": 10,
   "text": "Now nothing gets lost.",
   "start": 19.645,
   "end": 21.205
  },
  {
   "index": 11,
   "text": "We build this for you.",
   "start": 21.505,
   "end": 22.89
  },
  {
   "index": 12,
   "text": "Link in bio.",
   "start": 22.97,
   "end": 24.205
  }
 ],
