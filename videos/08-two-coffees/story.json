    {"span": [0.32, 1.21], "chunks": ["Two *coffees."]},
    {"span": [2.18, 3.31], "chunks": ["I was eating", "*alone."]},
    {"span": [4.06, 5.24], "chunks": ["The waitress", "smiled."]},
    {"span": [6.24, 8.23], "chunks": ["\"For your *friend.", "Black,", "two sugars.\""]},
    {"span": [8.89, 10.45], "chunks": ["That's how", "my *father", "drank it."]},
    {"span": [11.15, 12.34], "chunks": ["He *died", "in March."]},
    {"span": [12.99, 15.64], "chunks": ["I asked her…", "what *friend?"]},
    {"span": [16.30, 20.42], "chunks": ["\"The tall man", "in the *green *jacket.", "He walked in", "with *you.\""]},
    {"span": [21.09, 22.73], "chunks": ["We buried Dad", "in that *jacket."]},
    {"span": [23.52, 24.88], "chunks": ["I looked down", "at my plate."]},
    {"span": [25.55, 27.95], "chunks": ["When I looked up,", "his cup was", "*half *empty."]},
    {"span": [28.67, 31.69], "chunks": ["I went to pay.", "It was", "already *paid."]},
    {"span": [32.38, 34.38], "chunks": ["And on the tip line,", "in his", "*handwriting…"]},
    {"span": [35.08, 36.04], "chunks": ["\"Proud of you,", "*kid.\""]},
    {"span": [36.72, 39.62], "chunks": ["Now every time", "I stop", "at that diner,", "I *order…"]}
