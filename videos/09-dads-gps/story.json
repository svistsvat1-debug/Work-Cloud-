  "lines": [
    {"span": [0.33, 2.72], "chunks": ["My dad's truck", "hasn't *moved", "in *2 *years."]},
    {"span": [3.38, 5.77], "chunks": ["But the *GPS", "says it drives", "*every *night."]},
    {"span": [6.48, 8.01], "chunks": ["*2:47 AM."]},
    {"span": [8.97, 9.99], "chunks": ["38 *miles."]},
    {"span": [10.07, 10.65], "chunks": ["Same route."]},
    {"span": [11.40, 13.26], "chunks": ["Mom said", "the tracker", "was *broken."]},
    {"span": [13.93, 15.61], "chunks": ["So I drove", "the route *myself."]},
    {"span": [16.30, 17.13], "chunks": ["Highway *9."]},
    {"span": [18.09, 18.94], "chunks": ["The old *diner."]},
    {"span": [19.08, 19.74], "chunks": ["The *bridge."]},
    {"span": [20.45, 23.41], "chunks": ["And it ended…", "in my *driveway."]},
    {"span": [24.12, 26.72], "chunks": ["Four *minutes.", "Engine *running."]},
    {"span": [27.41, 28.53], "chunks": ["Every single *night."]},
    {"span": [29.27, 31.33], "chunks": ["Last night,", "it didn't come", "to my house."]},
    {"span": [31.99, 36.14], "chunks": ["It went", "to the *hospital…", "where my *son", "was born", "that morning."]},
    {"span": [36.82, 38.78], "chunks": ["The nurse asked me", "just *one thing."]},
    {"span": [39.48, 43.68], "chunks": ["\"Who was", "the old man", "in the *green *jacket…", "*holding *him?\""]}
  ],
