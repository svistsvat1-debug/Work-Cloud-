 "lines": [
  {
   "span": [
    0.32,
    2.3
   ],
   "chunks": [
    "My dad died",
    "sixteen",
    "years ago."
   ]
  },
  {
   "span": [
    2.97,
    5.25
   ],
   "chunks": [
    "Last night,",
    "he wrote in",
    "his logbook",
    "again."
   ]
  },
  {
   "span": [
    5.97,
    7.9
   ],
   "chunks": [
    "His old Kenworth",
    "sits in my barn."
   ]
  },
  {
   "span": [
    8.93,
    10.01
   ],
   "chunks": [
    "It never moves."
   ]
  },
  {
   "span": [
    10.66,
    12.62
   ],
   "chunks": [
    "But every morning,",
    "there's a new line."
   ]
  },
  {
   "span": [
    13.65,
    14.57
   ],
   "chunks": [
    "His handwriting."
   ]
  },
  {
   "span": [
    15.26,
    16.33
   ],
   "chunks": [
    "3:10 a.m."
   ]
  },
  {
   "span": [
    17.29,
    18.42
   ],
   "chunks": [
    "Forty-one miles."
   ]
  },
  {
   "span": [
    19.08,
    20.84
   ],
   "chunks": [
    "My wife says",
    "I write it",
    "in my sleep."
   ]
  },
  {
   "span": [
    21.64,
    22.95
   ],
   "chunks": [
    "So I slept",
    "in the cab."
   ]
  },
  {
   "span": [
    23.63,
    24.58
   ],
   "chunks": [
    "Nothing moved."
   ]
  },
  {
   "span": [
    25.25,
    27.01
   ],
   "chunks": [
    "At sunrise,",
    "there was",
    "a new line."
   ]
  },
  {
   "span": [
    27.73,
    28.8
   ],
   "chunks": [
    "3:10 a.m."
   ]
  },
  {
   "span": [
    29.75,
    30.56
   ],
   "chunks": [
    "No miles."
   ]
  },
  {
   "span": [
    31.22,
    32.3
   ],
   "chunks": [
    "Just four words:"
   ]
  },
  {
   "span": [
    33.18,
    34.08
   ],
   "chunks": [
    "“Went to",
    "meet him.”"
   ]
  },
  {
   "span": [
    34.76,
    37.19
   ],
   "chunks": [
    "My grandson",
    "was born at",
    "3:10",
    "that night."
   ]
  },
  {
   "span": [
    37.91,
    41.42
   ],
   "chunks": [
    "The nurse said",
    "a big man",
    "in an old",
    "trucker cap",
    "held him first."
   ]
  },
  {
   "span": [
    42.15,
    43.44
   ],
   "chunks": [
    "He smelled",
    "like diesel."
   ]
  }
 ],
