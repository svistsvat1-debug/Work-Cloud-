 "segments": [
  {
   "index": 0,
   "text": "A woodpecker bangs its head on trees all day,",
   "start": 0.1,
   "end": 2.86
  },
  {
   "index": 1,
   "text": "and never gets knocked out.",
   "start": 2.92,
   "end": 4.63
  },
  {
   "index": 2,
   "text": "So its brain is fine, right?",
   "start": 4.91,
   "end": 6.695
  },
  {
   "index": 3,
   "text": "In 2018, scientists checked woodpecker brains kept in museums.",
   "start": 7.095,
   "end": 11.88
  },
  {
   "index": 4,
   "text": "They found clumps of a protein called tau.",
   "start": 12.1,
   "end": 14.81
  },
  {
   "index": 5,
   "text": "In football players, that kind of buildup is linked to brain damage from years of hits.",
   "start": 15.13,
   "end": 20.19
  },
  {
   "index": 6,
   "text": "Blackbirds, which don't peck, showed none.",
   "start": 20.51,
   "end": 22.745
  },
  {
   "index": 7,
   "text": "So is it damage, or protection?",
   "start": 23.145,
   "end": 25.205
  },
  {
   "index": 8,
   "text": "Nobody's sure yet.",
   "start": 25.505,
   "end": 26.865
  }
 ],
