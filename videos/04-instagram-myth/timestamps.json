 "segments": [
  {
   "index": 0,
   "text": "\"I don't need a website. I have Instagram.\"",
   "start": 0.15,
   "end": 2.91
  },
  {
   "index": 1,
   "text": "Sound familiar?",
   "start": 3.21,
   "end": 4.345
  },
  {
   "index": 2,
   "text": "Here's the catch.",
   "start": 4.545,
   "end": 5.73
  },
  {
   "index": 3,
   "text": "On Instagram, you rent your audience.",
   "start": 6.03,
   "end": 8.465
  },
  {
   "index": 4,
   "text": "The algorithm decides who sees your posts.",
   "start": 8.625,
   "end": 11.31
  },
  {
   "index": 5,
   "text": "Your website is the place you own.",
   "start": 11.61,
   "end": 13.795
  },
  {
   "index": 6,
   "text": "It works 24/7, even when you don't post.",
   "start": 13.955,
   "end": 17.515
  },
  {
   "index": 7,
   "text": "So use Instagram to get attention.",
   "start": 17.815,
   "end": 20.225
  },
  {
   "index": 8,
   "text": "And your website to turn it into clients.",
   "start": 20.325,
   "end": 22.735
  },
  {
   "index": 9,
   "text": "Follow for more.",
   "start": 23.035,
   "end": 24.295
  }
 ],
