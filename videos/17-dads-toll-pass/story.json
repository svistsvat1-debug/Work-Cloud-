   ],
   "chunks": [
    "My dad's",
    "been dead",
    "sixteen years."
   ]
  },
  {
   "span": [
    3.02,
    4.77
   ],
   "chunks": [
    "His toll pass",
    "still gets charged."
   ]
  },
  {
   "span": [
    5.43,
    6.38
   ],
   "chunks": [
    "Every Friday."
   ]
  },
  {
   "span": [
    7.28,
    8.48
   ],
   "chunks": [
    "2:15 a.m."
   ]
  },
  {
   "span": [
    8.73,
    9.44
   ],
   "chunks": [
    "Same booth."
   ]
  },
  {
   "span": [
    10.12,
    11.33
   ],
   "chunks": [
    "They said",
    "it's a glitch."
   ]
  },
  {
   "span": [
    12.0,
    13.46
   ],
   "chunks": [
    "So I waited",
    "at that booth."
   ]
  },
  {
   "span": [
    14.14,
    15.19
   ],
   "chunks": [
    "Nothing",
    "came through."
   ]
  },
  {
   "span": [
    15.88,
    17.31
   ],
   "chunks": [
    "The charge",
    "showed up anyway."
   ]
  },
  {
   "span": [
    17.99,
    19.02
   ],
   "chunks": [
    "Then my son called."
   ]
  },
  {
   "span": [
    19.71,
    21.18
   ],
   "chunks": [
    "His car died",
    "on that road."
   ]
  },
  {
   "span": [
    22.24,
    23.31
   ],
   "chunks": [
    "At 2:15."
   ]
  },
  {
   "span": [
    23.97,
    25.96
   ],
   "chunks": [
    "An old green",
    "Kenworth",
    "stopped to help."
   ]
  },
  {
   "span": [
    26.73,
    28.5
   ],
   "chunks": [
    "The driver said",
    "just one thing:"
   ]
  },
  {
   "span": [
    29.17,
    30.05
   ],
   "chunks": [
    "“Tell your dad…"
   ]
  },
  {
   "span": [
    30.97,
    31.99
   ],
   "chunks": [
    "leave room",
    "to stop.”"
   ]
  }
 ],
