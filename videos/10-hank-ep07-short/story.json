 "lines": [
  {
   "span": [
    0.33,
    2.0
   ],
   "chunks": [
    "He fixed my engine",
    "for free."
   ]
  },
  {
   "span": [
    3.02,
    5.14
   ],
   "chunks": [
    "Then he tore a page",
    "out of my logbook."
   ]
  },
  {
   "span": [
    5.94,
    7.65
   ],
   "chunks": [
    "Ohio, 1996."
   ]
  },
  {
   "span": [
    8.63,
    10.01
   ],
   "chunks": [
    "One year behind the wheel."
   ]
  },
  {
   "span": [
    10.35,
    11.14
   ],
   "chunks": [
    "Running late."
   ]
  },
  {
   "span": [
    11.81,
    13.93
   ],
   "chunks": [
    "He worked under that hood",
    "for two hours."
   ]
  },
  {
   "span": [
    14.9,
    15.9
   ],
   "chunks": [
    "Not one word."
   ]
  },
  {
   "span": [
    16.57,
    17.94
   ],
   "chunks": [
    "Then he picked up my log."
   ]
  },
  {
   "span": [
    18.92,
    19.99
   ],
   "chunks": [
    "Read one page."
   ]
  },
  {
   "span": [
    20.16,
    20.79
   ],
   "chunks": [
    "And ripped it out."
   ]
  },
  {
   "span": [
    21.51,
    23.91
   ],
   "chunks": [
    "\"Write it true,\" he said,",
    "\"or don't write it.\""
   ]
  },
  {
   "span": [
    24.64,
    25.97
   ],
   "chunks": [
    "He wouldn't take a dime."
   ]
  },
  {
   "span": [
    26.67,
    30.15
   ],
   "chunks": [
    "Thirty years later,",
    "there's not one false line",
    "in my log."
   ]
  },
  {
   "span": [
    30.96,
    32.47
   ],
   "chunks": [
    "Full story's on the channel."
   ]
  },
  {
   "span": [
    33.14,
    35.36
   ],
   "chunks": [
    "And I still don't know",
    "why that old man…"
   ]
  }
 ],
