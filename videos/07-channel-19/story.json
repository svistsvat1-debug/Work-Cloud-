    {"span": [0.34, 2.30], "chunks": ["*Forty trucks", "on channel *19."]},
    {"span": [3.38, 4.87], "chunks": ["Only my radio", "*heard him."]},
    {"span": [5.56, 7.27], "chunks": ["*December,", "2001."]},
    {"span": [8.32, 10.19], "chunks": ["*Ice storm.", "Missouri hills."]},
    {"span": [10.72, 15.05], "chunks": ["A calm voice", "told me to stop", "at a *white *post,", "right before", "the *bridge."]},
    {"span": [15.71, 17.04], "chunks": ["I said,", "not on a *hill."]},
    {"span": [17.98, 18.88], "chunks": ["Not on *ice."]},
    {"span": [19.56, 21.48], "chunks": ["He said,", "\"Don't argue", "with me, *son.\""]},
    {"span": [22.17, 23.05], "chunks": ["So I *stopped."]},
    {"span": [23.75, 27.45], "chunks": ["*Four minutes later,", "three trucks", "*folded across", "that bridge."]},
    {"span": [28.11, 30.39], "chunks": ["Next morning,", "I told my dispatcher."]},
    {"span": [31.41, 32.99], "chunks": ["She went quiet", "for a full *minute."]},
    {"span": [33.47, 34.69], "chunks": ["Then she said", "his *name."]},
    {"span": [35.36, 37.18], "chunks": ["And I still", "don't know *why,", "out of…"]}
