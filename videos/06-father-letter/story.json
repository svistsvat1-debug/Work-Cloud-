  "subtitle_y": 1000,
  "lines": [
    {"span": [0.27, 3.58], "chunks": ["My father", "hid a letter", "under his truck seat", "for *fifteen *years."]},
    {"span": [4.47, 5.73], "chunks": ["*Stamped.", "Addressed to me."]},
    {"span": [6.16, 7.76], "chunks": ["Dated the morning", "I left home."]},
    {"span": [8.02, 9.13], "chunks": ["We *never", "spoke again."]},
    {"span": [10.16, 11.84], "chunks": ["When he died,", "I finally found it."]},
    {"span": [12.41, 17.0], "chunks": ["And at the bottom,", "in *different *ink,", "written years later,", "he'd added", "two more lines."]},
    {"span": [17.9, 19.35], "chunks": ["\"Saw the weather", "in *Nevada."]},
    {"span": [19.69, 20.91], "chunks": ["Glad you took", "the *exit.\""]},
    {"span": [21.37, 22.94], "chunks": ["I never told him", "about that night."]},
    {"span": [23.99, 25.21], "chunks": ["I never told", "*anyone."]},
    {"span": [25.55, 27.0], "chunks": ["So how did", "my father *know?"]}
  ],
