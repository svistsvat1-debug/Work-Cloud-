  {
   "index": 0,
   "text": "This website was losing clients.",
   "start": 0.15,
   "end": 2.41
  },
  {
   "index": 1,
   "text": "Let's fix it, step by step.",
   "start": 2.71,
   "end": 4.57
  },
  {
   "index": 2,
   "text": "First, the headline.",
