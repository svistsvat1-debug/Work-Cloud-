  {
   "index": 4,
   "text": "Next, one button.",
   "start": 8.26,
   "end": 9.545
  },
  {
   "index": 5,
   "text": "One clear next step: Book a cleaning.",
   "start": 9.645,
   "end": 12.18
  },
  {
   "index": 6,
   "text": "Then, trust.",
   "start": 12.48,
   "end": 13.465
  },
  {
   "index": 7,
   "text": "Show reviews right next to the button.",
   "start": 13.565,
   "end": 15.925
  },
  {
   "index": 8,
   "text": "Finally, mobile.",
   "start": 16.225,
   "end": 17.535
  },
  {
   "index": 9,
   "text": "Your clients probably see it on their phone.",
   "start": 17.635,
   "end": 20.07
  },
  {
   "index": 10,
   "text": "Before. And after.",
   "start": 20.37,
   "end": 21.755
  },
  {
   "index": 11,
   "text": "Follow for more.",
   "start": 22.155,
   "end": 23.415
  }
 ],
