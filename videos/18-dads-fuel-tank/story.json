    "My dad's",
    "been gone",
    "sixteen years."
   ]
  },
  {
   "span": [
    2.98,
    4.41
   ],
   "chunks": [
    "I still fill",
    "his truck's tank."
   ]
  },
  {
   "span": [
    5.11,
    6.66
   ],
   "chunks": [
    "And every month,",
    "it's empty."
   ]
  },
  {
   "span": [
    7.34,
    9.05
   ],
   "chunks": [
    "A hundred",
    "and fifty gallons."
   ]
  },
  {
   "span": [
    9.71,
    11.57
   ],
   "chunks": [
    "The truck never",
    "leaves the barn."
   ]
  },
  {
   "span": [
    12.25,
    13.89
   ],
   "chunks": [
    "My wife said",
    "someone's stealing it."
   ]
  },
  {
   "span": [
    14.57,
    16.03
   ],
   "chunks": [
    "So I put a lock",
    "on the cap."
   ]
  },
  {
   "span": [
    16.71,
    17.53
   ],
   "chunks": [
    "Empty again."
   ]
  },
  {
   "span": [
    18.21,
    19.85
   ],
   "chunks": [
    "Then a stranger's",
    "letter came."
   ]
  },
  {
   "span": [
    20.55,
    21.96
   ],
   "chunks": [
    "“Your dad",
    "saved my life."
   ]
  },
  {
   "span": [
    22.89,
    24.09
   ],
   "chunks": [
    "Blizzard on I-80."
   ]
  },
  {
   "span": [
    24.4,
    25.51
   ],
   "chunks": [
    "My tank was dry."
   ]
  },
  {
   "span": [
    26.22,
    26.94
   ],
   "chunks": [
    "He filled it."
   ]
  },
  {
   "span": [
    27.89,
    29.0
   ],
   "chunks": [
    "Wouldn't take a dime."
   ]
  },
  {
   "span": [
    29.68,
    31.18
   ],
   "chunks": [
