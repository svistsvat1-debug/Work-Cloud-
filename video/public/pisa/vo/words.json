{
 "voice": "am_michael",
 "speed": 1.0,
 "lines": [
  {
   "line": 0,
   "text": "The Leaning Tower of Pisa should have fallen before it was even finished.",
   "start": 0.1,
   "end": 4.289
  },
  {
   "line": 1,
   "text": "Only three floors up, the soft clay under it was close to giving way.",
   "start": 4.589,
   "end": 9.293
  },
  {
   "line": 2,
   "text": "Then the work stopped for almost a hundred years, probably because of wars.",
   "start": 9.633,
   "end": 14.635
  },
  {
   "line": 3,
   "text": "And that's basically what saved it.",
   "start": 15.185,
   "end": 17.209
  },
  {
   "line": 4,
   "text": "The tower's weight slowly squeezed water out of the clay, so the clay got stronger.",
   "start": 17.549,
   "end": 22.766
  },
  {
   "line": 5,
   "text": "Engineers say without that break, it would've toppled.",
   "start": 23.126,
   "end": 26.635
  }
 ],
