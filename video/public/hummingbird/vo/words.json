 "lines": [
  {
   "text": "How does a hummingbird survive a cold night without food?",
   "spoken": "How does a hummingbird survive a cold night without food?",
   "start": 0.0,
   "end": 3.073
  },
  {
   "text": "It burns energy so fast that staying warm until morning could use up its fat.",
   "spoken": "It burns energy so fast that staying warm until morning could use up its fat.",
   "start": 3.453,
   "end": 8.386
  },
  {
   "text": "So it does the opposite.",
   "spoken": "So it does the opposite.",
   "start": 8.686,
   "end": 10.0
  },
  {
   "text": "It goes still and lets its body go cold.",
   "spoken": "It goes still and lets its body go cold.",
   "start": 10.22,
   "end": 12.876
  },
  {
   "text": "Its heartbeat drops from about 1,200 a minute to as low as 40.",
   "spoken": "Its heartbeat drops from about twelve hundred a minute to as low as forty.",
   "start": 13.216,
   "end": 17.296
  },
  {
   "text": "One black metaltail cooled to 3.3 degrees Celsius.",
   "spoken": "One black metal tail cooled to three point three degrees Celsius.",
   "start": 17.616,
   "end": 21.525
  },
  {
   "text": "That's fridge cold.",
   "spoken": "That's fridge cold.",
   "start": 21.765,
   "end": 22.963
  },
  {
   "text": "No bird has been measured colder.",
   "spoken": "No bird has been measured colder.",
   "start": 23.203,
   "end": 25.131
  }
 ],
