 "shots": [
  {
   "id": "01_1",
   "start": 0.0,
   "end": 5.1395,
   "voStart": 0.326,
   "voEnd": 4.662,
   "sfx": "wind (field) bed, low",
   "text": "In August nineteen forty-five, Japan still had thousands of hidden warplanes."
  },
  {
   "id": "01_2",
   "start": 5.1395,
   "end": 8.707,
   "voStart": 5.617,
   "voEnd": 8.246,
   "sfx": null,
   "text": "It still had warships, sailors, and harbors full of mines."
  },
  {
   "id": "01_3",
   "start": 8.707,
   "end": 11.679,
   "voStart": 9.168,
   "voEnd": 11.228,
   "sfx": null,
   "text": "Two years later, almost all of it was gone."
  },
  {
   "id": "01_4",
   "start": 11.679,
   "end": 17.105,
   "voStart": 12.13,
   "voEnd": 16.608,
   "sfx": "distant ship engine (lib)",
   "text": "But in nineteen fifty, a few of its old ships slipped out in secret, heading for a war."
  },
  {
   "id": "01_5",
   "start": 17.105,
   "end": 20.107,
   "voStart": 17.602,
   "voEnd": 19.628,
   "sfx": "soft whoosh (lib)",
   "text": "So what really happened to Japan's war machine?"
  },
  {
   "id": "02_1",
   "start": 20.107,
   "end": 28.186,
   "voStart": 20.586,
   "voEnd": 27.604,
   "sfx": null,
   "text": "On September second, nineteen forty-five, Japan signed the surrender aboard the battleship USS Missouri in Tokyo Bay."
  },
  {
   "id": "02_2",
   "start": 28.186,
   "end": 30.9095,
   "voStart": 28.768,
   "voEnd": 30.785,
   "sfx": null,
   "text": "The Allies' first demand was simple."
  },
  {
   "id": "02_3",
   "start": 30.9095,
   "end": 34.257,
   "voStart": 31.034,
   "voEnd": 33.714,
   "sfx": null,
   "text": "Nothing Japanese would ever fly into battle again."
  },
  {
   "id": "03_1",
   "start": 34.257,
   "end": 39.0325,
   "voStart": 34.8,
   "voEnd": 38.528,
   "sfx": "wind (field) bed",
   "text": "Japan's leaders had been saving those hidden planes for one final battle."
  },
  {
   "id": "03_2",
   "start": 39.0325,
   "end": 42.178,
   "voStart": 39.537,
   "voEnd": 42.065,
   "sfx": "paper/map unfold (lib)",
   "text": "They expected an invasion of the home islands."
  },
  {
   "id": "03_3",
   "start": 42.178,
   "end": 46.4555,
   "voStart": 42.291,
   "voEnd": 45.913,
   "sfx": null,
   "text": "Many of the planes were meant to be flown straight into the invasion fleet."
  },
  {
   "id": "03_4",
   "start": 46.4555,
   "end": 52.323499999999996,
   "voStart": 46.998,
   "voEnd": 51.818,
   "sfx": null,
   "text": "Across Japan, ground crews were now ordered to take the propellers off their own aircraft."
  },
  {
   "id": "03_5",
   "start": 52.323499999999996,
   "end": 58.4695,
   "voStart": 52.829,
   "voEnd": 57.96,
   "sfx": null,
   "text": "Fighters that had been fueled for that last battle sat on the grass like birds with their wings clipped."
  },
  {
   "id": "03_6",
   "start": 58.4695,
   "end": 63.6485,
   "voStart": 58.979,
   "voEnd": 63.143,
   "sfx": null,
   "text": "Many of the young pilots had trained for missions they were never meant to return from."
  },
  {
   "id": "03_7",
   "start": 63.6485,
   "end": 67.964,
   "voStart": 64.154,
   "voEnd": 67.477,
   "sfx": null,
   "text": "Now they watched the planes they would have died in being dragged into piles."
  },
  {
   "id": "04_1",
   "start": 67.964,
   "end": 71.608,
   "voStart": 68.451,
   "voEnd": 71.163,
   "sfx": "light rain bed",
   "text": "But the Americans did not destroy everything at once."
  },
  {
   "id": "04_2",
   "start": 71.608,
   "end": 74.95400000000001,
   "voStart": 72.053,
   "voEnd": 74.513,
   "sfx": null,
   "text": "They wanted to know exactly how these machines were built."
  },
  {
   "id": "04_3",
   "start": 74.95400000000001,
   "end": 80.26400000000001,
   "voStart": 75.395,
   "voEnd": 79.801,
   "sfx": null,
   "text": "So intelligence teams picked out about four examples of each new aircraft type."
  },
  {
   "id": "04_4",
   "start": 80.26400000000001,
   "end": 85.744,
   "voStart": 80.727,
   "voEnd": 85.263,
   "sfx": null,
   "text": "Those planes were crated, loaded onto ships, and sent across the Pacific to be tested."
  },
  {
   "id": "04_5",
   "start": 85.744,
   "end": 89.19200000000001,
   "voStart": 86.225,
   "voEnd": 88.733,
   "sfx": null,
   "text": "A few of them still sit in American museums today."
  },
  {
   "id": "04_6",
   "start": 89.19200000000001,
   "end": 92.286,
   "voStart": 89.651,
   "voEnd": 91.868,
   "sfx": "distant crackle (lib fire)",
   "text": "The rest were burned, crushed, or cut up for scrap."
  },
  {
   "id": "04_7",
   "start": 92.286,
   "end": 95.69,
   "voStart": 92.704,
   "voEnd": 95.202,
   "sfx": null,
   "text": "The work dragged on well into nineteen forty-seven."
  },
  {
   "id": "05_1",
   "start": 95.69,
   "end": 97.991,
   "voStart": 96.178,
   "voEnd": 97.565,
   "sfx": null,
   "text": "Planes were easy to destroy, though."
  },
  {
   "id": "05_2",
   "start": 97.991,
   "end": 102.2165,
   "voStart": 98.417,
   "voEnd": 101.706,
   "sfx": null,
   "text": "Ships were a different problem, because Japan desperately needed them."
  },
  {
   "id": "06_1",
   "start": 102.2165,
   "end": 107.3135,
   "voStart": 102.727,
   "voEnd": 106.808,
   "sfx": "typewriter (lib)",
   "text": "When the war ended, more than six million Japanese were stranded far from home."
  },
  {
   "id": "06_2",
   "start": 107.3135,
   "end": 110.9915,
   "voStart": 107.819,
   "voEnd": 110.53,
   "sfx": null,
   "text": "About half were soldiers, and the other half were civilians."
  },
  {
   "id": "06_3",
   "start": 110.9915,
   "end": 115.833,
   "voStart": 111.453,
   "voEnd": 115.341,
   "sfx": null,
   "text": "They were scattered from the cold plains of Manchuria to the jungles of New Guinea."
  },
  {
   "id": "06_4",
   "start": 115.833,
   "end": 118.20599999999999,
   "voStart": 116.325,
   "voEnd": 118.079,
   "sfx": "waves (lib ship bed, low)",
   "text": "Many of them were sick and hungry."
  },
  {
   "id": "06_5",
   "start": 118.20599999999999,
   "end": 122.45750000000001,
   "voStart": 118.333,
   "voEnd": 121.912,
   "sfx": null,
   "text": "They waited on beaches and in camps with nothing but a name on a list."
  },
  {
   "id": "07_1",
   "start": 122.45750000000001,
   "end": 125.95500000000001,
   "voStart": 123.003,
   "voEnd": 125.495,
   "sfx": null,
   "text": "So the defeated navy was given one last mission."
  },
  {
   "id": "07_2",
   "start": 125.95500000000001,
   "end": 130.6345,
   "voStart": 126.415,
   "voEnd": 130.157,
   "sfx": null,
   "text": "Its surviving warships were stripped of their guns and turned into ferries."
  },
  {
   "id": "07_3",
   "start": 130.6345,
   "end": 133.14499999999998,
   "voStart": 131.112,
   "voEnd": 132.718,
   "sfx": "ship horn (lib), distant",
   "text": "Even aircraft carriers joined in."
  },
  {
   "id": "08_1",
   "start": 133.14499999999998,
   "end": 136.7545,
   "voStart": 133.572,
   "voEnd": 136.267,
   "sfx": null,
   "text": "The carrier Katsuragi had been finished too late to fight."
  },
  {
   "id": "08_2",
   "start": 136.7545,
   "end": 139.92200000000003,
   "voStart": 137.242,
   "voEnd": 139.467,
   "sfx": null,
   "text": "She never sent a single squadron into battle."
  },
  {
   "id": "08_3",
   "start": 139.92200000000003,
   "end": 145.84949999999998,
   "voStart": 140.377,
   "voEnd": 145.319,
   "sfx": null,
   "text": "Now her empty hangars were filled with exhausted men coming home from places like Rabaul."
  },
  {
   "id": "08_4",
   "start": 145.84949999999998,
   "end": 149.46300000000002,
   "voStart": 146.38,
   "voEnd": 149.014,
   "sfx": null,
   "text": "The old carrier Hosho became a passenger ship too."
  },
  {
   "id": "08_5",
   "start": 149.46300000000002,
   "end": 154.196,
   "voStart": 149.912,
   "voEnd": 153.734,
   "sfx": null,
   "text": "She was one of the first ships in the world designed as a carrier from the keel up."
  },
  {
   "id": "08_6",
   "start": 154.196,
   "end": 159.748,
   "voStart": 154.658,
   "voEnd": 159.275,
   "sfx": "wind (field) low",
   "text": "For a soldier who had not seen Japan in years, the first view of home came from a warship."
  },
  {
   "id": "08_7",
   "start": 159.748,
   "end": 162.4225,
   "voStart": 160.221,
   "voEnd": 161.957,
   "sfx": null,
   "text": "It was a warship that had lost its war."
  },
  {
   "id": "09_1",
   "start": 162.4225,
   "end": 165.008,
   "voStart": 162.888,
   "voEnd": 164.568,
   "sfx": null,
   "text": "But this mission could not last forever."
  },
  {
   "id": "09_2",
   "start": 165.008,
   "end": 169.8125,
   "voStart": 165.448,
   "voEnd": 169.354,
   "sfx": null,
   "text": "By the end of nineteen forty-six, Katsuragi was being cut up for scrap."
  },
  {
   "id": "09_3",
   "start": 169.8125,
   "end": 175.1855,
   "voStart": 170.271,
   "voEnd": 174.657,
   "sfx": null,
   "text": "Once the ferries were no longer needed, the winners had to decide who would keep the rest."
  },
  {
   "id": "10_1",
   "start": 175.1855,
   "end": 181.3945,
   "voStart": 175.714,
   "voEnd": 180.937,
   "sfx": "clock tick (lib), quiet",
   "text": "Four Allied powers wanted a share: the United States, Britain, China, and the Soviet Union."
  },
  {
   "id": "10_2",
   "start": 181.3945,
   "end": 186.3955,
   "voStart": 181.852,
   "voEnd": 185.856,
   "sfx": null,
   "text": "China asked for special treatment, because its own navy had been almost wiped out."
  },
  {
   "id": "10_3",
   "start": 186.3955,
   "end": 189.67000000000002,
   "voStart": 186.935,
   "voEnd": 189.541,
   "sfx": null,
   "text": "The solution sounds almost like a game show."
  },
  {
   "id": "10_4",
   "start": 189.67000000000002,
   "end": 194.56650000000002,
   "voStart": 189.799,
   "voEnd": 194.032,
   "sfx": null,
   "text": "The remaining destroyers and smaller warships were split into four equal groups."
  },
  {
   "id": "10_5",
   "start": 194.56650000000002,
   "end": 198.3425,
   "voStart": 195.101,
   "voEnd": 197.829,
   "sfx": "paper rustle (lib map)",
   "text": "Each country then drew lots to see which group it would receive."
  },
  {
   "id": "11_1",
   "start": 198.3425,
   "end": 201.505,
   "voStart": 198.856,
   "voEnd": 201.075,
   "sfx": null,
   "text": "One of those ships was the destroyer Yukikaze."
  },
  {
   "id": "11_2",
   "start": 201.505,
   "end": 205.276,
   "voStart": 201.935,
   "voEnd": 204.817,
   "sfx": null,
   "text": "She had fought in some of the biggest naval battles of the war."
  },
  {
   "id": "11_3",
   "start": 205.276,
   "end": 207.86950000000002,
   "voStart": 205.735,
   "voEnd": 207.433,
   "sfx": null,
   "text": "Somehow, she survived every one of them."
  },
  {
   "id": "11_4",
   "start": 207.86950000000002,
   "end": 214.24200000000002,
   "voStart": 208.306,
   "voEnd": 213.726,
   "sfx": null,
   "text": "Out of eighty-two Japanese destroyers built before the war, she was one of only three still afloat."
  },
  {
   "id": "11_5",
   "start": 214.24200000000002,
   "end": 220.2575,
   "voStart": 214.758,
   "voEnd": 219.737,
   "sfx": null,
   "text": "In July nineteen forty-seven, she was handed over to China and given a new name, Tan Yang."
  },
  {
   "id": "11_6",
   "start": 220.2575,
   "end": 223.4675,
   "voStart": 220.778,
   "voEnd": 222.992,
   "sfx": null,
   "text": "Her old enemy now flew its flag over her deck."
  },
  {
   "id": "12_1",
   "start": 223.4675,
   "end": 227.8995,
   "voStart": 223.943,
   "voEnd": 227.428,
   "sfx": "wind (snow) bed",
   "text": "Another survivor, the destroyer Hibiki, went to the Soviet Union."
  },
  {
   "id": "12_2",
   "start": 227.8995,
   "end": 231.3625,
   "voStart": 228.371,
   "voEnd": 230.911,
   "sfx": null,
   "text": "The Soviets renamed her Verniy, which means faithful."
  },
  {
   "id": "12_3",
   "start": 231.3625,
   "end": 233.915,
   "voStart": 231.814,
   "voEnd": 233.801,
   "sfx": null,
   "text": "She was faithful to a new owner now."
  },
  {
   "id": "12_4",
   "start": 233.915,
   "end": 238.2255,
   "voStart": 234.029,
   "voEnd": 237.681,
   "sfx": null,
   "text": "Most of the ships that went to America and Britain had a shorter future."
  },
  {
   "id": "12_5",
   "start": 238.2255,
   "end": 241.865,
   "voStart": 238.77,
   "voEnd": 241.372,
   "sfx": null,
   "text": "They were not needed, so most of them were simply scrapped."
  },
  {
   "id": "13_1",
   "start": 241.865,
   "end": 244.806,
   "voStart": 242.358,
   "voEnd": 244.365,
   "sfx": null,
   "text": "But some ships were too famous to give away."
  },
  {
   "id": "13_2",
   "start": 244.806,
   "end": 248.115,
   "voStart": 245.247,
   "voEnd": 247.618,
   "sfx": null,
   "text": "For those, the Americans had a very different plan."
  },
  {
   "id": "14_1",
   "start": 248.115,
   "end": 254.5545,
   "voStart": 248.612,
   "voEnd": 254.045,
   "sfx": null,
   "text": "The battleship Nagato had once been the flagship of the Combined Fleet, Japan's main battle fleet."
  },
  {
   "id": "14_2",
   "start": 254.5545,
   "end": 260.01649999999995,
   "voStart": 255.064,
   "voEnd": 259.513,
   "sfx": null,
   "text": "Admiral Yamamoto had commanded from her decks in the first days of the Pacific war."
  },
  {
   "id": "14_3",
   "start": 260.01649999999995,
   "end": 264.6335,
   "voStart": 260.52,
   "voEnd": 264.065,
   "sfx": null,
   "text": "By the end of the war, she was the last Japanese battleship still afloat."
  },
  {
   "id": "15_1",
   "start": 264.6335,
   "end": 268.9885,
   "voStart": 265.202,
   "voEnd": 268.503,
   "sfx": "distant ship engine (lib)",
   "text": "An American crew took her over and sailed her across the Pacific."
  },
  {
   "id": "15_2",
   "start": 268.9885,
   "end": 273.438,
   "voStart": 269.474,
   "voEnd": 272.949,
   "sfx": "paper/map unfold (lib)",
   "text": "Her destination was a tiny ring of islands called Bikini Atoll."
  },
  {
   "id": "15_3",
   "start": 273.438,
   "end": 276.627,
   "voStart": 273.927,
   "voEnd": 276.199,
   "sfx": null,
   "text": "There, she became a target for atomic bomb tests."
  },
  {
   "id": "15_4",
   "start": 276.627,
   "end": 282.7405,
   "voStart": 277.055,
   "voEnd": 282.177,
   "sfx": "low distant rumble (lib artillery, very soft)",
   "text": "On July first, nineteen forty-six, the first bomb exploded in the air above the anchored fleet."
  },
  {
   "id": "15_5",
   "start": 282.7405,
   "end": 285.554,
   "voStart": 283.304,
   "voEnd": 285.457,
   "sfx": null,
   "text": "Nagato survived with little damage."
  },
  {
   "id": "15_6",
   "start": 285.554,
   "end": 289.0685,
   "voStart": 285.651,
   "voEnd": 288.554,
   "sfx": null,
   "text": "Three weeks later, a second bomb exploded underwater."
  },
  {
   "id": "15_7",
   "start": 289.0685,
   "end": 292.54200000000003,
   "voStart": 289.583,
   "voEnd": 292.097,
   "sfx": null,
   "text": "The old battleship stayed afloat for four more days."
  },
  {
   "id": "15_8",
   "start": 292.54200000000003,
   "end": 297.0235,
   "voStart": 292.987,
   "voEnd": 296.547,
   "sfx": null,
   "text": "Then, on the night of July twenty-ninth, she slowly rolled over and sank."
  },
  {
   "id": "15_9",
   "start": 297.0235,
   "end": 300.51800000000003,
   "voStart": 297.5,
   "voEnd": 300.026,
   "sfx": null,
   "text": "Today she lies upside down on the bottom of the lagoon."
  },
  {
   "id": "16_1",
   "start": 300.51800000000003,
   "end": 303.7255,
   "voStart": 301.01,
   "voEnd": 303.264,
   "sfx": null,
   "text": "So the planes were burned, and the big ships were gone."
  },
  {
   "id": "16_2",
   "start": 303.7255,
   "end": 308.03549999999996,
   "voStart": 304.187,
   "voEnd": 307.505,
   "sfx": "tension riser (lib), soft",
   "text": "But one part of the war machine was still out there, waiting in the water."
  },
  {
   "id": "17_1",
   "start": 308.03549999999996,
   "end": 313.64300000000003,
   "voStart": 308.566,
   "voEnd": 313.148,
   "sfx": null,
   "text": "During the war, Japan had laid tens of thousands of mines to protect its own harbors."
  },
  {
   "id": "17_2",
   "start": 313.64300000000003,
   "end": 318.0455,
   "voStart": 314.138,
   "voEnd": 317.574,
   "sfx": "plane fly-by (lib), distant",
   "text": "American bombers dropped thousands more to strangle Japan's shipping."
  },
  {
   "id": "17_3",
   "start": 318.0455,
   "end": 320.79949999999997,
   "voStart": 318.517,
   "voEnd": 320.678,
   "sfx": null,
   "text": "The mines did not know the war was over."
  },
  {
   "id": "17_4",
   "start": 320.79949999999997,
   "end": 325.778,
   "voStart": 320.921,
   "voEnd": 325.189,
   "sfx": null,
   "text": "Fishing boats, ferries and cargo ships kept hitting them, and people kept dying."
  },
  {
   "id": "18_1",
   "start": 325.778,
   "end": 328.05150000000003,
   "voStart": 326.367,
   "voEnd": 327.629,
   "sfx": "wind (field) bed",
   "text": "Somebody had to clear the water."
  },
  {
   "id": "18_2",
   "start": 328.05150000000003,
   "end": 334.12,
   "voStart": 328.474,
   "voEnd": 334.0,
   "sfx": null,
   "text": "Therefore the Allies kept one small piece of the Japanese navy alive: its minesweepers."
  },
  {
   "id": "18_3",
   "start": 334.12,
   "end": 338.24199999999996,
   "voStart": 334.24,
   "voEnd": 337.734,
   "sfx": null,
   "text": "Many of the crews were the same men who had served in the Imperial Navy."
  },
  {
   "id": "18_4",
   "start": 338.24199999999996,
   "end": 342.3705,
   "voStart": 338.75,
   "voEnd": 341.899,
   "sfx": null,
   "text": "They went out day after day, dragging cables through cold water."
  },
  {
   "id": "18_5",
   "start": 342.3705,
   "end": 346.6545,
   "voStart": 342.842,
   "voEnd": 346.161,
   "sfx": null,
   "text": "Every sailor knew the next mine could go off right under his own hull."
  },
  {
   "id": "18_6",
   "start": 346.6545,
   "end": 350.20500000000004,
   "voStart": 347.148,
   "voEnd": 349.737,
   "sfx": null,
   "text": "Their work was slow, dangerous, and almost invisible."
  },
  {
   "id": "18_7",
   "start": 350.20500000000004,
   "end": 354.821,
   "voStart": 350.673,
   "voEnd": 354.304,
   "sfx": null,
   "text": "It was the only part of Japan's war machine that never stopped working."
  },
  {
   "id": "18_8",
   "start": 354.821,
   "end": 358.14250000000004,
   "voStart": 355.338,
   "voEnd": 357.651,
   "sfx": null,
   "text": "But soon, Japan would face a much bigger question."
  },
  {
   "id": "19_1",
   "start": 358.14250000000004,
   "end": 363.115,
   "voStart": 358.634,
   "voEnd": 362.643,
   "sfx": null,
   "text": "In May nineteen forty-seven, Japan's new constitution came into force."
  },
  {
   "id": "19_2",
   "start": 363.115,
   "end": 366.9145,
   "voStart": 363.587,
   "voEnd": 366.446,
   "sfx": "paper rustle (lib)",
   "text": "Its ninth article said that Japan gave up war forever."
  },
  {
   "id": "19_3",
   "start": 366.9145,
   "end": 371.441,
   "voStart": 367.383,
   "voEnd": 370.965,
   "sfx": null,
   "text": "It also said that Japan would never keep land, sea, or air forces."
  },
  {
   "id": "19_4",
   "start": 371.441,
   "end": 376.275,
   "voStart": 371.917,
   "voEnd": 375.752,
   "sfx": null,
   "text": "For the first time in its modern history, Japan had no military at all."
  },
  {
   "id": "20_1",
   "start": 376.275,
   "end": 381.5825,
   "voStart": 376.798,
   "voEnd": 381.09,
   "sfx": "distant artillery (lib), very low",
   "text": "Then, on June twenty-fifth, nineteen fifty, North Korea invaded South Korea."
  },
  {
   "id": "20_2",
   "start": 381.5825,
   "end": 386.036,
   "voStart": 382.075,
   "voEnd": 385.537,
   "sfx": "ship horn (lib), distant",
   "text": "The American troops guarding Japan were rushed across the sea to fight."
  },
  {
   "id": "20_3",
   "start": 386.036,
   "end": 389.4785,
   "voStart": 386.535,
   "voEnd": 389.002,
   "sfx": null,
   "text": "Suddenly, Japan itself was almost undefended."
  },
  {
   "id": "21_1",
   "start": 389.4785,
   "end": 397.47299999999996,
   "voStart": 389.955,
   "voEnd": 396.916,
   "sfx": "marching column (lib), soft",
   "text": "Within weeks, the occupation authorities ordered a new force called the National Police Reserve, with seventy-five thousand men."
  },
  {
   "id": "21_2",
   "start": 397.47299999999996,
   "end": 402.51,
   "voStart": 398.03,
   "voEnd": 402.014,
   "sfx": null,
   "text": "It was called a police force, but it was armed and organized much like an army."
  },
  {
   "id": "21_3",
   "start": 402.51,
   "end": 405.4815,
   "voStart": 403.006,
   "voEnd": 405.365,
   "sfx": null,
   "text": "On land, Japan now had an answer of sorts."
  },
  {
   "id": "21_4",
   "start": 405.4815,
   "end": 407.50800000000004,
   "voStart": 405.598,
   "voEnd": 406.995,
   "sfx": null,
   "text": "The sea was another story."
  },
  {
   "id": "22_1",
   "start": 407.50800000000004,
   "end": 415.194,
   "voStart": 408.021,
   "voEnd": 414.668,
   "sfx": null,
   "text": "In October nineteen fifty, United Nations forces planned a landing at Wonsan, a port on North Korea's east coast."
  },
  {
   "id": "22_2",
   "start": 415.194,
   "end": 418.33450000000005,
   "voStart": 415.72,
   "voEnd": 418.235,
   "sfx": "tension riser (lib), soft",
   "text": "But the harbor was full of Soviet-made mines."
  },
  {
   "id": "22_3",
   "start": 418.33450000000005,
   "end": 422.4985,
   "voStart": 418.434,
   "voEnd": 421.912,
   "sfx": null,
   "text": "The Americans did not have enough minesweepers to clear them in time."
  },
  {
   "id": "23_1",
   "start": 422.4985,
   "end": 427.2805,
   "voStart": 423.085,
   "voEnd": 426.807,
   "sfx": "clock tick (lib)",
   "text": "So on October second, Rear Admiral Arleigh Burke made a quiet request."
  },
  {
   "id": "23_2",
   "start": 427.2805,
   "end": 434.7555,
   "voStart": 427.754,
   "voEnd": 434.212,
   "sfx": null,
   "text": "He asked Takeo Okubo, the head of Japan's new Maritime Safety Agency, to send minesweepers to Korea."
  },
  {
   "id": "23_3",
   "start": 434.7555,
   "end": 439.59450000000004,
   "voStart": 435.299,
   "voEnd": 439.076,
   "sfx": null,
   "text": "Okubo refused at first, because the new constitution seemed to forbid it."
  },
  {
   "id": "23_4",
   "start": 439.59450000000004,
   "end": 442.942,
   "voStart": 440.113,
   "voEnd": 442.838,
   "sfx": null,
   "text": "He took the question to Prime Minister Shigeru Yoshida."
  },
  {
   "id": "23_5",
   "start": 442.942,
   "end": 444.66949999999997,
   "voStart": 443.046,
   "voEnd": 444.173,
   "sfx": null,
   "text": "Yoshida said yes."
  },
  {
   "id": "24_1",
   "start": 444.66949999999997,
   "end": 452.67949999999996,
   "voStart": 445.166,
   "voEnd": 452.12,
   "sfx": "distant ship engine (lib)",
   "text": "On October sixth, sixteen Japanese minesweepers carrying about twelve hundred men left the port of Shimonoseki for Korea."
  },
  {
   "id": "24_2",
   "start": 452.67949999999996,
   "end": 457.4305,
   "voStart": 453.239,
   "voEnd": 456.938,
   "sfx": null,
   "text": "Many of these small ships had been built for the Imperial Navy during the war."
  },
  {
   "id": "24_3",
   "start": 457.4305,
   "end": 461.15049999999997,
   "voStart": 457.923,
   "voEnd": 460.688,
   "sfx": null,
   "text": "Five years earlier, these sailors had been America's enemy."
  },
  {
   "id": "24_4",
   "start": 461.15049999999997,
   "end": 464.8035,
   "voStart": 461.613,
   "voEnd": 464.326,
   "sfx": null,
   "text": "Now they were sweeping mines in front of an American fleet."
  },
  {
   "id": "25_1",
   "start": 464.8035,
   "end": 468.99649999999997,
   "voStart": 465.281,
   "voEnd": 468.527,
   "sfx": "single soft boom (lib), well under the voice",
   "text": "Off Wonsan, minesweeper M S fourteen struck a mine and sank."
  },
  {
   "id": "25_2",
   "start": 468.99649999999997,
   "end": 472.0435,
   "voStart": 469.466,
   "voEnd": 471.903,
   "sfx": null,
   "text": "One man was killed, and eighteen were injured."
  },
  {
   "id": "25_3",
   "start": 472.0435,
   "end": 477.3635,
   "voStart": 472.184,
   "voEnd": 476.794,
   "sfx": null,
   "text": "A month later, an American army tugboat with a Japanese crew hit another mine."
  },
  {
   "id": "25_4",
   "start": 477.3635,
   "end": 480.4425,
   "voStart": 477.933,
   "voEnd": 479.977,
   "sfx": null,
   "text": "Twenty-two of its twenty-seven crewmen died."
  },
  {
   "id": "26_1",
   "start": 480.4425,
   "end": 482.265,
   "voStart": 480.908,
   "voEnd": 481.889,
   "sfx": null,
   "text": "There was a bitter twist."
  },
  {
   "id": "26_2",
   "start": 482.265,
   "end": 487.71500000000003,
   "voStart": 482.641,
   "voEnd": 487.217,
   "sfx": null,
   "text": "While the mines were being cleared, South Korean troops had already taken Wonsan by land."
  },
  {
   "id": "26_3",
   "start": 487.71500000000003,
   "end": 492.35249999999996,
   "voStart": 488.213,
   "voEnd": 491.868,
   "sfx": null,
   "text": "When the American landing finally came, the beach was already secure."
  },
  {
   "id": "26_4",
   "start": 492.35249999999996,
   "end": 495.76800000000003,
   "voStart": 492.837,
   "voEnd": 495.287,
   "sfx": null,
   "text": "But the men who died clearing the way did not come back."
  },
  {
   "id": "27_1",
   "start": 495.76800000000003,
   "end": 498.355,
   "voStart": 496.249,
   "voEnd": 497.927,
   "sfx": null,
   "text": "Their families were told almost nothing."
  },
  {
   "id": "27_2",
   "start": 498.355,
   "end": 504.1795,
   "voStart": 498.783,
   "voEnd": 503.627,
   "sfx": "typewriter (lib), 2 keystrokes",
   "text": "The whole operation stayed top secret for twenty-nine years, and no medals were ever given."
  },
  {
   "id": "28_1",
   "start": 504.1795,
   "end": 507.2,
   "voStart": 504.732,
   "voEnd": 506.757,
   "sfx": null,
   "text": "So what really happened to Japan's war machine?"
  },
  {
   "id": "28_2",
   "start": 507.2,
   "end": 510.361,
   "voStart": 507.643,
   "voEnd": 509.917,
   "sfx": null,
   "text": "Its planes were stripped of their propellers and burned."
  },
  {
   "id": "28_3",
   "start": 510.361,
   "end": 513.3235,
   "voStart": 510.805,
   "voEnd": 513.189,
   "sfx": null,
   "text": "Its warships carried millions of people home."
  },
  {
   "id": "28_4",
   "start": 513.3235,
   "end": 517.8675000000001,
   "voStart": 513.458,
   "voEnd": 517.325,
   "sfx": null,
   "text": "After that, they were raffled off, scrapped, or sunk by atomic bombs."
  },
  {
   "id": "28_5",
   "start": 517.8675000000001,
   "end": 522.145,
   "voStart": 518.41,
   "voEnd": 521.662,
   "sfx": null,
   "text": "But its smallest ships, and the men who sailed them, never really stopped."
  },
  {
   "id": "28_6",
   "start": 522.145,
   "end": 528.3375000000001,
   "voStart": 522.628,
   "voEnd": 527.821,
   "sfx": null,
   "text": "Five years after the surrender, they were back in a war zone, sweeping mines for their former enemy."
  },
  {
   "id": "28_7",
   "start": 528.3375000000001,
   "end": 535.9405,
   "voStart": 528.854,
   "voEnd": 535.378,
   "sfx": null,
   "text": "In nineteen fifty-four, Japan created its Maritime Self-Defense Force, and the minesweeping crews became part of it."
  },
  {
   "id": "28_8",
   "start": 535.9405,
   "end": 539.289,
   "voStart": 536.503,
   "voEnd": 538.85,
   "sfx": null,
   "text": "The war machine had been taken apart, piece by piece."
  },
  {
   "id": "28_9",
   "start": 539.289,
   "end": 542.341,
   "voStart": 539.728,
   "voEnd": 541.865,
   "sfx": null,
   "text": "But a few of its pieces had simply been waiting."
  },
  {
   "id": "29_1",
   "start": 542.341,
   "end": 547.059,
   "voStart": 542.817,
   "voEnd": 546.614,
   "sfx": null,
   "text": "Japan was not the only defeated navy that the winners divided up."
  },
  {
   "id": "29_2",
   "start": 547.059,
   "end": 553.954,
   "voStart": 547.504,
   "voEnd": 553.382,
   "sfx": null,
   "text": "Italy's battleships were handed out too, and one of them exploded in a Soviet harbor ten years after the war."
  },
  {
   "id": "29_3",
   "start": 553.954,
   "end": 561.684,
   "voStart": 554.526,
   "voEnd": 559.184,
   "sfx": "soft whoosh (lib)",
   "text": "That mystery is our next story, so subscribe if you want to find out what really sank her."
  }
 ]
}